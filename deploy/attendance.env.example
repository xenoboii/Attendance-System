# Settings for the Raspberry Pi. install.sh copies this to /etc/attendance.env
# (edit that file, then:  sudo systemctl restart attendance-web attendance-rfid)

# real hardware instead of the laptop simulator
SIMULATE_HARDWARE=0
# rc522 = RC522 module on the GPIO pins (see docs/PI_SETUP.md)
RFID_BACKEND=rc522

# web addresses (the Pi's own hotspot answers these names)
STUDENT_HOST=attendance.lan
PROF_HOSTS=prof.attendance.lan

# who may create instructor accounts - CHANGE THIS before the defense / deployment
INSTRUCTOR_REGISTRATION_CODE=PROF-2026

# GPIO pins (BCM numbers). Only change these if you wired them differently.
BUZZER_GPIO=18
LED_GREEN_GPIO=23
LED_RED_GPIO=24
LCD_I2C_ADDRESS=0x27

# Battery % from the 18650 UPS board. Run `i2cdetect -y 1` to see which chip yours has:
#   36 -> max17040   (Geekworm X728-style; also set BATTERY_PLD_GPIO=6 for its charging signal)
#   42 (or 40/41/43) -> ina219   (Waveshare-style; set BATTERY_I2C_ADDRESS if not 0x42)
#   nothing new      -> none      (the battery badge stays hidden)
BATTERY_BACKEND=none
#BATTERY_I2C_ADDRESS=0x42
#BATTERY_PLD_GPIO=6
# 2 cells side by side = 1; 2 cells in series (7.4V boards) = 2
BATTERY_CELLS_SERIES=1
# shut down safely at 5% when not charging (protects the SD card)
BATTERY_SHUTDOWN=1

LOG_LEVEL=INFO
